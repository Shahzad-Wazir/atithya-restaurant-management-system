# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/atithya?retryWrites=true&w=majority

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your_super_secret_jwt_key_here

# CORS Allowed Origins (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Cloudinary (for menu image uploads; falls back to direct image URLs if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Initial Staff/User Seed Accounts (only needed if running `npm run seed`)
# Leave blank if you prefer to create accounts manually. Never commit real credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_KITCHEN_EMAIL=
SEED_KITCHEN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
